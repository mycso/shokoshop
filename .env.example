# Gelato print fulfillment
GELATO_API_KEY=
GELATO_STORE_ID=
GELATO_WEBHOOK_SECRET=

# Stripe payments — if unset, checkout falls back to a "demo mode" that marks orders paid immediately
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Vercel Blob storage (orders, returns, reviews, product overrides)
BLOB_READ_WRITE_TOKEN=

# Admin dashboard password (plain comparison at login; session is a signed JWT, not the password itself)
ADMIN_PASSWORD=

# Postgres database (customer accounts, password resets, 2FA, rate limiting) — Vercel Postgres, Neon, or Supabase
# If using Supabase: use the pooled "Transaction" connection string (port 6543, ?pgbouncer=true) here.
# Append &sslmode=no-verify if the pg driver rejects Supabase's cert chain (still encrypted, just skips CA verification).
DATABASE_URL=
# Only needed ad hoc for `prisma migrate` against a pooled provider (Supabase) — pass the direct/session
# connection string (port 5432, no pgbouncer) inline, e.g. `DATABASE_URL="$DIRECT_URL" npx prisma migrate dev`.
# Not read by the app itself, so it's not wired into schema.prisma/prisma.config.ts.
DIRECT_URL=

# Random secret used to sign customer session cookies, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Resend (transactional email: welcome, order confirmation, password reset)
RESEND_API_KEY=
EMAIL_FROM=

# Store owner inbox — receives a copy of every new order and return/refund request
ADMIN_EMAIL=
